# Used by `npm run local` (vite --mode emulator). Talks to the local Firebase
# emulators only — no real Firebase project, no internet database. Safe to commit.
VITE_FIREBASE_API_KEY=demo-key
VITE_FIREBASE_AUTH_DOMAIN=demo-fts.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=demo-fts
VITE_FIREBASE_STORAGE_BUCKET=demo-fts.appspot.com
VITE_FIREBASE_APP_ID=demo-app
VITE_USE_EMULATOR=true
