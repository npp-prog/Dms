rules_version = '2';

// FTS - Financial Transaction System
// Roles: superadmin > admin > user. New accounts start inactive until an
// admin approves them. The superadmin is the owner's email below (keep it in
// sync with src/lib/owner.js); it is granted only once Firebase has verified
// the address (Google sign-in, or the email/password verification link).
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }
    function profilePath() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }
    function hasProfile() {
      return signedIn() && exists(profilePath());
    }
    function profile() {
      return get(profilePath()).data;
    }
    function isActive() {
      return hasProfile() && profile().active == true;
    }
    function isAdmin() {
      return isActive() && profile().role in ['admin', 'superadmin'];
    }
    function isSuper() {
      return isActive() && profile().role == 'superadmin';
    }
    function isOwnerEmail() {
      return signedIn()
        && request.auth.token.email_verified == true
        && request.auth.token.email.lower() in ['npp@mgocandoniaccounting.org'];
    }
    // The office the user belongs to (assigned by an admin); '' if none yet.
    function myOffice() {
      return profile().get('office', '');
    }
    function unchanged(keys) {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(keys);
    }

    // ---- System metadata ----
    match /meta/settings {
      allow read: if isActive();
      allow write: if isAdmin();
    }

    // ---- User profiles ----
    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());

      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.email == request.auth.token.email
        // The office is assigned by an admin, never chosen by the user.
        && request.resource.data.get('office', '') == '' && (
        // Regular self-registration: inactive user awaiting approval.
        (request.resource.data.role == 'user' && request.resource.data.active == false)
        // The owner's verified email: superadmin.
        || (request.resource.data.role == 'superadmin' && request.resource.data.active == true && isOwnerEmail())
      );

      allow update: if
        // Superadmin manages everyone (but cannot lock themselves out).
        (isSuper() && (request.auth.uid != uid || unchanged(['role', 'active'])))
        // Admin may approve/deactivate and edit regular users only.
        || (isAdmin() && request.auth.uid != uid
            && resource.data.role == 'user' && request.resource.data.role == 'user')
        // Anyone may edit their own name (not their office: that decides what they can see).
        || (request.auth.uid == uid && unchanged(['role', 'active', 'email', 'office']))
        // The owner becomes superadmin once their email is verified.
        || (request.auth.uid == uid && isOwnerEmail()
            && request.resource.data.role == 'superadmin' && request.resource.data.active == true
            && unchanged(['email', 'office']));

      allow delete: if isSuper() && request.auth.uid != uid;
    }

    // ---- Document types (formats, guided steps, processing guides) ----
    match /documentTypes/{typeId} {
      allow read: if isActive();
      allow write: if isAdmin();
    }

    // ---- Checklist library (requirements per transaction type, keyed by checklist no.) ----
    match /checklists/{code} {
      allow read: if isActive();
      allow write: if isAdmin();
    }

    // ---- Prepared documents ----
    // Users see their own documents and those of their office; admins see all.
    match /documents/{docId} {
      allow read: if isActive()
        && (resource.data.createdBy == request.auth.uid || isAdmin()
            || (resource.data.get('office', '') != '' && resource.data.get('office', '') == myOffice()));
      allow create: if isActive()
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.get('office', '') == myOffice();
      allow update: if isActive()
        && (isAdmin() || (resource.data.createdBy == request.auth.uid
                          && resource.data.status != 'cancelled'))
        && unchanged(['createdBy', 'createdAt', 'typeId', 'controlNo', 'typeSnapshot', 'office']);
      allow delete: if isAdmin()
        || (isActive() && resource.data.createdBy == request.auth.uid
            && resource.data.status == 'draft');
    }

    // ---- Control number sequences ----
    match /counters/{counterId} {
      allow read: if isActive();
      allow create: if isActive() && request.resource.data.value == 1;
      allow update: if isActive() && request.resource.data.value == resource.data.value + 1;
      allow delete: if isSuper();
    }
  }
}
