rules_version = '2';

// FTS - Financial Transaction System
// Roles: superadmin > admin > user. New accounts start inactive until an
// admin approves them. The superadmin is the owner's email below (keep it in
// sync with src/lib/owner.js); it is granted only once Firebase has verified
// the address (Google sign-in, or the email/password verification link).
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }
    function profilePath() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }
    function hasProfile() {
      return signedIn() && exists(profilePath());
    }
    function profile() {
      return get(profilePath()).data;
    }
    function isActive() {
      return hasProfile() && profile().active == true;
    }
    function isAdmin() {
      return isActive() && profile().role in ['admin', 'superadmin'];
    }
    function isSuper() {
      return isActive() && profile().role == 'superadmin';
    }
    function isOwnerEmail() {
      return signedIn()
        && request.auth.token.email_verified == true
        && request.auth.token.email.lower() in ['npp@mgocandoniaccounting.org'];
    }
    // The office the user belongs to (assigned by an admin); '' if none yet.
    function myOffice() {
      return profile().get('office', '');
    }
    function unchanged(keys) {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(keys);
    }

    // ---- System metadata ----
    match /meta/settings {
      allow read: if isActive();
      allow write: if isAdmin();
    }

    // ---- User profiles ----
    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());

      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.email == request.auth.token.email
        // The office is assigned by an admin, never chosen by the user.
        && request.resource.data.get('office', '') == ''
        && request.resource.data.get('head', false) == false && (
        // Regular self-registration: inactive user awaiting approval.
        (request.resource.data.role == 'user' && request.resource.data.active == false)
        // The owner's verified email: superadmin.
        || (request.resource.data.role == 'superadmin' && request.resource.data.active == true && isOwnerEmail())
      );

      allow update: if
        // Superadmin manages everyone (but cannot lock themselves out).
        (isSuper() && (request.auth.uid != uid || unchanged(['role', 'active'])))
        // Admin may approve/deactivate and edit regular users only.
        || (isAdmin() && request.auth.uid != uid
            && resource.data.role == 'user' && request.resource.data.role == 'user')
        // Anyone may edit their own name (not their office, office head or routing to any person:
        // they decide what they can see and do).
        || (request.auth.uid == uid && unchanged(['role', 'active', 'email', 'office', 'head', 'canRefer']))
        // The owner becomes superadmin once their email is verified.
        || (request.auth.uid == uid && isOwnerEmail()
            && request.resource.data.role == 'superadmin' && request.resource.data.active == true
            && unchanged(['email', 'office']));

      allow delete: if isSuper() && request.auth.uid != uid;
    }

    // ---- Document types (formats, guided steps, processing guides) ----
    match /documentTypes/{typeId} {
      allow read: if isActive();
      allow write: if isAdmin();
    }

    // ---- Checklist library (requirements per transaction type, keyed by checklist no.) ----
    match /checklists/{code} {
      allow read: if isActive();
      allow write: if isAdmin();
    }

    // ---- Prepared documents ----
    // A user sees the documents they prepared, and the documents waiting in their office to be
    // received, signed and released (not a colleague's document still at the preparer's step).
    // The office head sees every document of the office and every document routed through it.
    // Admins see all.
    match /documents/{docId} {
      function holder() {
        return resource.data.get('currentOffice', '');
      }
      function isHead() {
        return myOffice() != '' && profile().get('head', false) == true;
      }
      // Waiting in the user's office at a routed step (atPreparer: the preparer's own step).
      function heldByMyOffice() {
        return myOffice() != '' && holder() == myOffice()
          && resource.data.get('atPreparer', true) == false;
      }
      // Referred by the office holding it to this user (outside the route): they receive it, act
      // (e.g. sign) and send it back.
      function referredToMe() {
        return holder() == 'person:' + request.auth.uid;
      }
      // The office that referred it keeps seeing it while it is out (read only).
      function referredByMyOffice() {
        return myOffice() != '' && holder().matches('person:.*')
          && resource.data.workflow.get('referral', {}).get('fromOffice', '') == myOffice();
      }
      // Referring a document to a person: admins, and users allowed to route to any person.
      function referralAllowed() {
        return !request.resource.data.get('currentOffice', '').matches('person:.*')
          || resource.data.get('currentOffice', '').matches('person:.*')
          || isAdmin() || profile().get('canRefer', false) == true;
      }
      // The fields the current route step assigns on receiving (e.g. dvNo and dvDate) or fills in
      // (e.g. checkNo, checkDate, bankName), if any.
      function assignedKeys() {
        let step = resource.data.workflow.steps[resource.data.workflow.stage];
        let assign = step.get('assign', {});
        return [assign.get('field', '-'), assign.get('dateField', '-')].concat(step.get('fills', []));
      }
      function headSees() {
        return isHead() && (resource.data.get('office', '') == myOffice() || holder() == myOffice()
          || myOffice() in resource.data.get('routeOffices', []));
      }
      // The workflow fields change only through the office holding the document.
      function workflowUntouched() {
        return unchanged(['workflow', 'currentOffice', 'routeOffices', 'atPreparer']);
      }
      allow read: if isActive()
        && (resource.data.createdBy == request.auth.uid || isAdmin() || heldByMyOffice() || headSees() || referredToMe() || referredByMyOffice()
            // forwarded to this user
            || request.auth.uid in resource.data.get('sharedWith', []));
      allow create: if isActive()
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.get('office', '') == myOffice();
      allow update: if isActive()
        && unchanged(['createdBy', 'createdAt', 'typeId', 'controlNo', 'typeSnapshot', 'office'])
        && referralAllowed()
        && (isAdmin()
            // The person it is referred to receives it, signs its PDF and sends it back.
            || (referredToMe()
                && request.resource.data.diff(resource.data).affectedKeys()
                     .hasOnly(['workflow', 'currentOffice', 'routeOffices', 'atPreparer', 'pdf', 'updatedAt', 'history']))
            // The preparer edits their document; its route only while it is with their office
            // (or before it is routed).
            || (resource.data.createdBy == request.auth.uid && resource.data.status != 'cancelled'
                && (workflowUntouched() || !('workflow' in resource.data)
                    || (resource.data.workflow.state == 'in-progress'
                        && (holder() == '' || holder() == myOffice()))))
            // The office holding a routed document receives, releases or returns it, and signs its PDF.
            // (Its office head too, also at the preparer's step.) On receiving, it may assign a
            // reference no.: only the field (and date) its own route step assigns change.
            || ((heldByMyOffice() || (isHead() && holder() == myOffice()))
                && request.resource.data.diff(resource.data).affectedKeys()
                     .hasOnly(['workflow', 'currentOffice', 'routeOffices', 'atPreparer', 'pdf', 'updatedAt', 'history', 'data', 'refNos', 'stepFiles', 'sharedWith', 'forwards'])
                && request.resource.data.get('data', {}).diff(resource.data.get('data', {})).affectedKeys().hasOnly(assignedKeys())
                && request.resource.data.get('refNos', {}).diff(resource.data.get('refNos', {})).affectedKeys().hasOnly(assignedKeys())));
      allow delete: if isAdmin()
        || (isActive() && resource.data.createdBy == request.auth.uid
            && resource.data.status == 'draft');
    }

    // ---- Directory: names and offices of active users (to forward a document to someone) ----
    match /directory/{uid} {
      allow read: if isActive();
      allow write: if isActive() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['displayName', 'office', 'email'])
        && request.resource.data.office == myOffice()
        && request.resource.data.get('email', '') in ['', request.auth.token.email];
    }

    // ---- Verification records ----
    // One per PDF version DMS stored, keyed by the file's SHA-256: anyone holding a copy can
    // check it (Verify page, no sign-in). They can be read one at a time, never listed.
    match /verifications/{hash} {
      allow get: if true;
      allow list: if false;
      allow create: if isActive() && hash.matches('^[0-9a-f]{64}$')
        && request.resource.data.keys().hasOnly(['controlNo', 'typeCode', 'typeName', 'version', 'kind', 'signer', 'signatures', 'by', 'at']);
      allow update, delete: if false;
    }

    // ---- Control number sequences ----
    match /counters/{counterId} {
      allow read: if isActive();
      allow create: if isActive() && request.resource.data.value == 1;
      allow update: if isActive() && request.resource.data.value == resource.data.value + 1;
      allow delete: if isSuper();
    }
  }
}
