rules_version = '2';

// PDFs of documents and their signed versions: documents/{docId}/{n}-{kind}.pdf
// Who may read or add a file follows the document in Firestore (firestore.rules).
// Files are never replaced or deleted: each signature adds a new file, so every
// version stays on record.
service firebase.storage {
  match /b/{bucket}/o {
    function profile() {
      return firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data;
    }
    function docOf(docId) {
      return firestore.get(/databases/(default)/documents/documents/$(docId)).data;
    }
    function isActive() {
      return request.auth != null && profile().active == true;
    }
    function isAdmin() {
      return profile().role in ['admin', 'superadmin'];
    }
    function myOffice() {
      return profile().get('office', '');
    }
    function isHead() {
      return myOffice() != '' && profile().get('head', false) == true;
    }
    // Waiting in the user's office at a routed step (not at the preparer's own step).
    function heldByMyOffice(d) {
      return myOffice() != '' && d.get('currentOffice', '') == myOffice() && d.get('atPreparer', true) == false;
    }
    // Referred to this user by the office holding it (outside the route).
    function referredToMe(d) {
      return d.get('currentOffice', '') == 'person:' + request.auth.uid;
    }
    // Same as firestore.rules: the preparer, the office the document is waiting in, the office
    // head (every document of the office and every one routed through it), admins, and the person
    // it is referred to.
    function referredByMyOffice(d) {
      return myOffice() != '' && d.get('currentOffice', '').matches('person:.*')
        && d.workflow.get('referral', {}).get('fromOffice', '') == myOffice();
    }
    // The Records Officer (a position) reads every document's files.
    function isRecords() {
      return 'Records Officer' in profile().get('positions', []);
    }
    function canRead(d) {
      return isAdmin() || isRecords() || d.createdBy == request.auth.uid || heldByMyOffice(d) || referredToMe(d) || referredByMyOffice(d) || request.auth.uid in d.get('sharedWith', [])
        || (isHead() && (d.get('office', '') == myOffice() || d.get('currentOffice', '') == myOffice()
            || myOffice() in d.get('routeOffices', [])));
    }
    // At a routed step that names positions, only the people in them (and the office head).
    function holdsStepPosition(d) {
      return isHead() || d.workflow.steps[d.workflow.stage].get('positions', []).size() == 0
        || profile().get('positions', []).hasAny(d.workflow.steps[d.workflow.stage].get('positions', []));
    }
    // The preparer, or the office now holding the document (its head too).
    function canAdd(d) {
      return isAdmin() || (d.status != 'cancelled'
        && (d.createdBy == request.auth.uid || (heldByMyOffice(d) && holdsStepPosition(d)) || referredToMe(d)
            || (isHead() && d.get('currentOffice', '') == myOffice())));
    }

    // The signatory's own PNPKI certificate file (signing.p12), kept so they sign with their password
    // only, and their signature mark (mark.png). Nobody else can read them, not even admins.
    // The certificate password is never stored.
    match /certificates/{uid}/{file} {
      allow read, delete: if request.auth != null && request.auth.uid == uid
        && file.matches('signing\\.p12|mark\\.png');
      allow create, update: if request.auth != null && request.auth.uid == uid
        && ((file == 'signing.p12' && request.resource.size < 64 * 1024)
            || (file == 'mark.png' && request.resource.size < 2 * 1024 * 1024));
    }

    // Supporting documents uploaded to the checklist items (scanned PDFs, photos).
    match /documents/{docId}/attachments/{itemId}/{file} {
      allow read: if isActive() && canRead(docOf(docId));
      allow create: if resource == null && isActive() && canAdd(docOf(docId))
        && request.resource.contentType.matches('application/pdf|image/(jpeg|png|webp)')
        && request.resource.size < 20 * 1024 * 1024;
      allow update, delete: if false;
    }

    match /documents/{docId}/{file} {
      allow read: if isActive() && canRead(docOf(docId));
      // resource == null: a new file only, never over an existing version.
      allow create: if resource == null && isActive() && canAdd(docOf(docId))
        && file.matches('[0-9]+-(generated|signed|uploaded|stamped|restored)\\.pdf')
        && request.resource.contentType == 'application/pdf'
        && request.resource.size < 25 * 1024 * 1024;
      allow update, delete: if false;
    }
  }
}
